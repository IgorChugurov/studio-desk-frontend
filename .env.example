# Settings live in .env.development (pnpm dev) and .env.production (build and
# start). They hold public addresses only and are committed.
# To override a value on your machine, copy the line to .env.local (not
# committed). For example, to work against the remote API:
#   NEXT_PUBLIC_API_URL=https://api.studio-desk.axondigital.xyz/api/platform
# The remote API must allow your origin (CORS_EXTRA_ORIGINS on the server).

# Host of the platform admin. A request to this host shows the platform admin.
# Include the port for local hosts.
ADMIN_HOST=localhost:3001
# Host of the studio admin (not built yet; the host answers 404).
APP_HOST=app.localhost:3001
# Platform API address used by the browser, without a trailing slash.
# Read at build time: changing it needs a new build.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/platform
# Page of the studio admin that receives the handoff code after "Log in as
# studio" (the code is added after #). Read at build time.
NEXT_PUBLIC_STUDIO_ADMIN_URL=http://app.localhost:3001/impersonate
